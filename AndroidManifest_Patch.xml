<?xml version="1.0" encoding="utf-8"?>
<!-- 
  DoorDash Dasher App Deployment Manifest Patch
  Target Scope: Resolves Google Play Store device-footprint incompatibility loops.
-->
<manifest xmlns:android="http://android.com"
    package="com.doordash.driverapp"
    android:versionCode="20261020"
    android:versionName="7.99.0">

    <!-- System Runtime Targeting -->
    <uses-sdk 
        android:minSdkVersion="26" 
        android:targetSdkVersion="35" />

    <!-- Hardware Feature Profile Corrections -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Core Logistics Continuity -->
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">
        <!-- Extensible activity tree maps dynamically here -->
    </application>
</manifest>
